{
  "name": "times-table-hero",
  "description": "An interactive multiplication learning game for children",
  "version": "1.0.0",
  "author": "joaovl",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "verify": "tsc -b --noEmit && vitest run",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "coverage:merge": "node scripts/coverage-merge.cjs",
    "coverage:all": "node scripts/coverage-all.cjs",
    "gen:e2e-catalog": "node scripts/gen-e2e-catalog.cjs",
    "db:migrate:local": "wrangler d1 migrations apply tth-db --local",
    "db:tables:local": "wrangler d1 execute tth-db --local --command \"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;\"",
    "e2e:server": "vite build --mode e2e && wrangler d1 migrations apply tth-db --local && wrangler pages dev --port 8788",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.2.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260710.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "nyc": "^18.0.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vite-plugin-istanbul": "^6.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.110.0"
  }
}
